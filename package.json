{
  "name": "musicaldown",
  "type": "module",
  "version": "0.1.0",
  "description": "MusicallyDown: a free, browser-based TikTok video and MP3 downloader built with Astro.",
  "license": "MIT",
  "keywords": [
    "tiktok",
    "tiktok-downloader",
    "mp4",
    "mp3",
    "astro"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/solid-js": "^7.1.6",
    "@astrojs/vercel": "^11.0.22",
    "@betterlytics/tracker": "^0.2.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tobyg74/tiktok-api-dl": "^1.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "solid-js": "^1.9.19",
    "solid-toast": "^0.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
