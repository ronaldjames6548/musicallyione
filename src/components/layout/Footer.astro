---
/**
 * Footer.astro — Site footer with navigation columns and social links
 */
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const footerColumns = [
  {
    title: t('footer.product'),
    links: [
      { label: t('nav.home'), href: getLocalizedPath(lang, '/') },
      { label: t('nav.stories'), href: getLocalizedPath(lang, '/download-tiktok-stories') },
      { label: t('nav.mp3'), href: getLocalizedPath(lang, '/tiktok-mp3') },
    ],
  },
  {
    title: t('footer.resources'),
    links: [
      { label: t('nav.blog'), href: getLocalizedPath(lang, '/blog') },
      { label: t('nav.how'), href: getLocalizedPath(lang, '/about') },
      { label: t('nav.faq'), href: getLocalizedPath(lang, '/#faq') },
    ],
  },
  {
    title: t('footer.company'),
    links: [
      { label: t('nav.contact'), href: getLocalizedPath(lang, '/contact') },
      { label: t('footer.privacyPolicy'), href: getLocalizedPath(lang, '/privacy') },
      { label: t('footer.termsOfService'), href: getLocalizedPath(lang, '/terms') },
    ],
  },
];
---

<footer class="border-t border-[var(--border)] bg-white">
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <!-- Brand column -->
      <div class="col-span-2 md:col-span-1">
        <a href={getLocalizedPath(lang, '/')} class="flex items-center gap-2 font-display text-lg font-bold">
          <span class="font-display text-xl font-bold tracking-tight">Musical<span class="text-[var(--color-red-600)] dark:text-[var(--color-primary-400)]">Down</span>
          </span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-secondary)]">
          
        </p>

      
        
      </div>

      <!-- Navigation columns -->
      {footerColumns.map((column) => (
        <div>
          <h3 class="text-sm font-semibold text-[var(--text-primary)]">{column.title}</h3>
          <ul class="mt-3 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
                  {...(link.href.startsWith('http') && {
                    target: '_blank',
                    rel: 'noopener noreferrer',
                  })}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-[var(--border)] pt-8 text-sm text-[var(--text-tertiary)] md:flex-row">
      <div class="flex flex-col items-center gap-4 md:flex-row md:gap-6">
        <p>
          &copy; {currentYear} <span set:html={t('footer.copyright')} />
        </p>
        <!-- div class="flex gap-4" >
          <a
            href={getLocalizedPath(lang, '/privacy')}
            class="hover:text-[var(--text-primary)] transition-colors"
          >
            {t('footer.privacyPolicy')}
          </a>
          <a
            href={getLocalizedPath(lang, '/terms')}
            class="hover:text-[var(--text-primary)] transition-colors"
          >
            {t('footer.termsOfService')}
          </a>
        </!-->
      </div>
      
    </div>
  </div>
</footer>
