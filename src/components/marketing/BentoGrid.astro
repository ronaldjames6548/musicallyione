---
/**
 * BentoGrid.astro — Feature Highlights Grid
 *
 * A modern, CSS grid-based layout for highlighting key features.
 * Features span different rows/cols to create an asymmetric, "bento box" look.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface BentoItem {
  title: string;
  description: string;
  icon?: string; // SVG string or we can use an icon slot/component
  colSpan?: 1 | 2; // Span 1 or 2 columns
  rowSpan?: 1 | 2; // Span 1 or 2 rows
}

interface Props {
  title: string;
  subtitle?: string;
  items: BentoItem[];
}
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  bentotitle = t('bento.title'),
  bentohighlight = t('bento.highlight'),
  bentoparagraph = t('bento.paragraph'),
  bentoparagraph1 = t('bento.paragraph1'),
} = Astro.props;
// ── TikTok video quality card ──
const quality = {
  eyebrow: t('bento.quality.eyebrow'),
  title: t('bento.quality.title'),
  p1: t('bento.quality.p1'),
  p2: t('bento.quality.p2'),
  cta: t('bento.quality.cta'),
  guideLabel: t('bento.quality.guide.label'),
  guideHeading: t('bento.quality.guide.heading'),
  guideBadge: t('bento.quality.guide.badge'),
  levels: [
    { label: t('bento.quality.sd'), note: t('bento.quality.sd.note'), width: 'w-1/3', color: 'bg-slate-400' },
    { label: t('bento.quality.hd'), note: t('bento.quality.hd.note'), width: 'w-2/3', color: 'bg-violet-400' },
    { label: t('bento.quality.4k'), note: t('bento.quality.4k.note'), width: 'w-5/6', color: 'bg-[#ef124e]' },
  ],
};

// SVG icons (stroke = currentColor, so they follow the text colour)
const icons = {
  iphone: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="7" y="2" width="10" height="20" rx="2.5"/><path d="M10.5 5.5h3"/><path d="M11 18.5h2"/></svg>`,
  android: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 11a7 7 0 0 1 14 0z"/><path d="M8 4 6.5 2M16 4l1.5-2"/><circle cx="9.5" cy="8" r=".7" fill="currentColor"/><circle cx="14.5" cy="8" r=".7" fill="currentColor"/><path d="M5 13.5V18a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4.5z"/></svg>`,
  desktop: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>`,
};

// ── Mobile / desktop card ──
const devices = {
  eyebrow: t('bento.devices.eyebrow'),
  title: t('bento.devices.title'),
  paragraph: t('bento.devices.paragraph'),
  items: [
    { icon: icons.iphone, title: t('bento.devices.iphone.title'), desc: t('bento.devices.iphone.desc') },
    { icon: icons.android, title: t('bento.devices.android.title'), desc: t('bento.devices.android.desc') },
    { icon: icons.desktop, title: t('bento.devices.desktop.title'), desc: t('bento.devices.desktop.desc') },
  ],
};
---

<section id="features" class="py-8 md:py-8">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-6xl text-center">
        <h2 class="font-display text-3xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-4xl">{bentotitle} <span class="text-[#ef124e]"> {bentohighlight}</span></h2>
        <p class="mt-3 text-[var(--text-secondary)] leading-relaxed">{bentoparagraph} {bentoparagraph1}</p>
    </div>
  <section class="mx-auto max-w-7xl py-8 space-y-6 px-6 pb-10">
     
      <article class="scroll-mt-20 rounded-3xl border border-[var(--border)] bg-white p-8 md:p-10">
        <div class="grid items-center gap-8 lg:grid-cols-2">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[.18em] text-[#ef124e]">{quality.eyebrow}</p>
            <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-[var(--text-primary)] sm:text-3xl">{quality.title}</h2>
            <p class="mt-3 leading-relaxed text-[var(--text-secondary)]">{quality.p1}</p>
            <p class="mt-3 leading-relaxed text-[var(--text-secondary)]">{quality.p2}</p>
            <a href="/" class="mt-6 inline-flex items-center rounded-full bg-[#ef124e] px-6 py-3 font-semibold text-white transition hover:opacity-90">
              {quality.cta} <span class="ml-2" aria-hidden="true">↓</span>
            </a>
          </div>

          <div class="rounded-3xl border border-[var(--border)] bg-[var(--bg-secondary)] p-6 sm:p-8">
            <div class="flex items-center justify-between gap-3 border-b border-[var(--border)] pb-5">
              <div>
                <p class="text-sm text-[var(--text-tertiary)]">{quality.guideLabel}</p>
                <p class="mt-1 text-xl font-semibold text-[var(--text-primary)]">{quality.guideHeading}</p>
              </div>
              <span class="rounded-full border border-[var(--border)] bg-white px-3 py-1 text-xs font-semibold text-[var(--text-secondary)]">{quality.guideBadge}</span>
            </div>

            <div class="space-y-5 pt-6">
              {quality.levels.map((level) => (
                <div>
                  <div class="mb-2 flex justify-between text-sm">
                    <span class="font-semibold text-[var(--text-primary)]">{level.label}</span>
                    <span class="text-[var(--text-tertiary)]">{level.note}</span>
                  </div>
                  <div class="h-2 rounded-full bg-[var(--border)]">
                    <div class={`h-2 rounded-full ${level.width} ${level.color}`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </article>

      <article class="scroll-mt-20 rounded-3xl border border-[var(--border)] bg-white p-8 md:p-10">
        <div class="grid gap-8 lg:grid-cols-[.85fr_1.15fr] lg:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[.18em] text-[#ef124e]">{devices.eyebrow}</p>
            <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-[var(--text-primary)] sm:text-3xl">{devices.title}</h2>
            <p class="mt-3 leading-relaxed text-[var(--text-secondary)]">{devices.paragraph}</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-3">
            {devices.items.map((item) => (
              <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-secondary)] p-5">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-white border border-[var(--border)] text-[#ef124e]" set:html={item.icon} />
                <h3 class="mt-3 font-semibold text-[var(--text-primary)]">{item.title}</h3>
                <p class="mt-2 text-sm leading-6 text-[var(--text-secondary)]">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </article>
    </section>
  </div>
</section>