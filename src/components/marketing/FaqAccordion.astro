---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqtitle?: string;
  faqdescription?: string;
  faqs?: FaqItem[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Build the list from ui.ts (faq.question1 ... faq.answer10)
const FAQ_COUNT = 10;
const translatedFaqs: FaqItem[] = Array.from({ length: FAQ_COUNT }, (_, i) => {
  const n = i + 1;
  return {
    question: t(`faq.question${n}` as any),
    answer: t(`faq.answer${n}` as any),
  };
});

const {
  faqtitle = t('faq.title'),
  faqdescription = t('faq.description'),
  faqs = translatedFaqs, // falls back to the ui.ts data when no prop is passed
} = Astro.props;

// Keep only complete items (skips empty strings and untranslated keys like "faq.question7")
const validFaqs = faqs.filter(
  (f) =>
    f.question?.trim() &&
    f.answer?.trim() &&
    !f.question.startsWith('faq.') &&
    !f.answer.startsWith('faq.')
);

const stripHtml = (s: string) => s.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();

// Uses the production domain when `site` is set in astro.config.mjs
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  url: pageUrl,
  inLanguage: lang,
  mainEntity: validFaqs.map((faq) => ({
    '@type': 'Question',
    name: stripHtml(faq.question),
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(faq.answer),
    },
  })),
};

// Escape "<" so the JSON can never break out of the script tag
const faqJsonLd = JSON.stringify(faqSchema).replace(/</g, '\\u003c');
---

<section class="mx-auto max-w-7xl px-6 py-8 md:py-12" id="faq">
  {validFaqs.length > 0 && (
    <script type="application/ld+json" set:html={faqJsonLd} />
  )}

  <div class="text-center mb-12">
    <h2 class="font-display text-3xl font-bold tracking-tight text-[var(--text-primary)] sm:text-4xl">{faqtitle}</h2>
    {faqdescription && <p class="mt-4 text-lg text-[var(--text-secondary)]">{faqdescription}</p>}
  </div>

  <div class="space-y-4">
    {validFaqs.map((faq) => (
      <details class="group rounded-2xl border border-[var(--border)] bg-white [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer items-center justify-between gap-4 p-6 font-semibold text-[var(--text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary-500)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg)]">
          <span class="text-lg">{faq.question}</span>
          <span class="ml-6 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--bg-secondary)] transition-transform duration-300 group-open:rotate-180">
            <svg
              class="h-4 w-4 text-[var(--text-secondary)]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="px-6 pb-6 text-[var(--text-secondary)] leading-relaxed">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  /* Smooth native animation for the dropdown content */
  details[open] summary ~ * {
    animation: fade-slide-down 0.3s ease-in-out;
  }

  @keyframes fade-slide-down {
    0% {
      opacity: 0;
      transform: translateY(-8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>