---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import InputScreen from '../downloader/InputScreen';

interface Props {
  titleStart?: string;
  titleHighlight?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  titleStart = t('hero.titleStart'),
  titleHighlight = t('hero.titleHighlight'),
  description = t('hero.description'),
} = Astro.props;
---

<section class="flex flex-col items-center justify-center bg-[#ef124e] px-6 py-12 text-center">
  <h1 class="mx-auto max-w-4xl font-display text-3xl text-white font-semibold leading-tight tracking-tight text-white md:text-4xl">
    {titleStart}<span class="underline decoration-white underline-offset-4"> {titleHighlight}</span>
  </h1>

  <p class="mx-auto mt-4 max-w-3xl text-lg text-white md:text-xl">
    {description}
  </p>

  <div class="mt-2 w-full max-w-4xl">
    <InputScreen client:only="solid-js" />
  </div>
</section>