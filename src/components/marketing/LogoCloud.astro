---
/**
 * LogoCloud.astro — Social Proof component
 *
 * Displays a row of customer/partner logos.
 * Great for building trust on B2B SaaS landing pages.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Logo {
  name: string;
  src: string;
  darkSrc?: string;
  className?: string;
}

interface Props {
  title?: string;
  logos: Logo[];
}
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  section1title = t('section1.title'),
  section1highlight = t('section1.highlight'),
  section1paragraph = t('section1.paragraph'),
  section1paragraph2 = t('section1.paragraph2'),
} = Astro.props;

---

<section class="border-t border-[var(--border)] bg-[var(--bg-secondary)]/50 py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-6 text-center">
  <h1 class="font-display text-3xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-4xl">
    {section1title}<span class="text-[#ef124e]"> {section1highlight}</span>
  </h1>
    <p class="mt-3 text-[var(--text-secondary)] leading-relaxed">{section1paragraph} {section1paragraph2}</p>
    
    
  </div>
</section>
