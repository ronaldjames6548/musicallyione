---
import { getCollection } from 'astro:content';
import BlogList from '../../layouts/BlogList.astro';

// Get all non-draft posts, sorted by date descending
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.id.startsWith('en/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BlogList
  title="MusicalDown Blog"
  description="Guides on saving public TikTok videos, MP4 and MP3 formats, troubleshooting, and using downloads responsibly."
  posts={posts}
/>
