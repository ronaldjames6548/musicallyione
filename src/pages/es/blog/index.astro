---
import { getCollection } from 'astro:content';
import BlogList from '../../../layouts/BlogList.astro';

// Get all non-draft posts, sorted by date descending
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && post.id.startsWith('es/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BlogList
  title="Blog de MusicalDown"
  description="Guías para guardar videos públicos de TikTok, formatos MP4 y MP3, solución de problemas y uso responsable de las descargas."
  posts={posts}
  basePath="/es/blog/"
/>
