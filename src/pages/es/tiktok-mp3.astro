---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import HeroSection from '../../components/marketing/HeroSection.astro';
import ArticleBody from '../../components/marketing/ArticleBody.astro';
import { getMp3Content } from '../../i18n/ui';

// All text lives in MP3_PAGE (es) in src/i18n/ui.ts
const c = getMp3Content('es');
---
<BaseLayout title={c.metaTitle} description={c.metaDescription} ogType="article">
  <Header slot="header" />
  <HeroSection
    titleStart={c.heroTitleStart}
    titleHighlight={c.heroTitleHighlight}
    description={c.heroDescription}
  />
  <ArticleBody content={c} />
  <Footer slot="footer" />
</BaseLayout>
