---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
---
<BaseLayout title="Tentang MusicallyDown" description="MusicallyDown menyediakan alat berbasis browser untuk membantu pengguna menyimpan video TikTok publik ketika opsi unduhan tersedia.">
  <Header slot="header" />
  <main class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <article class="prose prose-zinc prose-lg mx-auto dark:prose-invert">
      <h1>Tentang MusicallyDown</h1>
      <p>MusicallyDown menyediakan alat berbasis browser untuk membantu pengguna menyimpan video TikTok publik ketika opsi unduhan tersedia.</p>
      <h2>Salin tautan video yang dapat diakses, tempelkan ke alat, lalu pilih format yang ditampilkan. Hormati hak cipta kreator dan ketentuan TikTok.</h2>
      <p>MusicallyDown menyediakan alat berbasis browser untuk membantu pengguna menyimpan video TikTok publik ketika opsi unduhan tersedia.</p>
      <p><a href="/id/">Kembali ke beranda</a></p>
    </article>
  </main>
  <Footer slot="footer" />
</BaseLayout>
