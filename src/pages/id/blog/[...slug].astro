---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
export async function getStaticPaths() { const posts = await getCollection('blog'); return posts.filter((post) => post.id.startsWith('id/')).map((post) => ({ params: { slug: post.id.replace('id/', '') }, props: { post } })); }
const { post } = Astro.props;
const { Content } = await render(post);
---
<BlogPost post={post}><Content /></BlogPost>
