---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import HeroSection from '../../components/marketing/HeroSection.astro';
import StoriesArticle from '../../components/marketing/StoriesArticle.astro';
import { getStoriesContent } from '../../i18n/ui';

// All text lives in STORIES_PAGE (id) in src/i18n/ui.ts
const c = getStoriesContent('id');
---
<BaseLayout title={c.metaTitle} description={c.metaDescription} ogType="article">
  <Header slot="header" />
  <HeroSection
    titleStart={c.heroTitleStart}
    titleHighlight={c.heroTitleHighlight}
    description={c.heroDescription}
  />
  <StoriesArticle />
  <Footer slot="footer" />
</BaseLayout>
