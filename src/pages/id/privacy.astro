---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
---
<BaseLayout title="Kebijakan Privasi" description="Kami memproses tautan yang Anda kirim untuk mencoba menemukan opsi media yang tersedia. Jangan kirim kata sandi atau informasi pribadi.">
  <Header slot="header" />
  <main class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <article class="prose prose-zinc prose-lg mx-auto dark:prose-invert">
      <h1>Kebijakan Privasi</h1>
      <p>Kami memproses tautan yang Anda kirim untuk mencoba menemukan opsi media yang tersedia. Jangan kirim kata sandi atau informasi pribadi.</p>
      <h2>Privasi dan Penggunaan Data</h2>
      <p>Kami memproses tautan yang Anda kirim untuk mencoba menemukan opsi media yang tersedia. Jangan kirim kata sandi atau informasi pribadi.</p>
      <p><a href="/id/">Kembali ke beranda</a></p>
    </article>
  </main>
  <Footer slot="footer" />
</BaseLayout>
