---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const k = (key: string) => t(key as Parameters<typeof t>[0]);

const autoItems = [1, 2, 3, 4];
const useItems = [1, 2, 3, 4, 5, 6];
const choiceItems = [1, 2, 3];
---

<BaseLayout title={t('privacy.metaTitle')} description={t('privacy.metaDescription')}>
  <Header slot="header" />

  <main class="mx-auto max-w-4xl bg-white px-6 py-20 md:py-32">
    <header class="mb-12 md:mb-16">
      <h1 class="font-display text-4xl font-extrabold tracking-tight text-[var(--text-primary)] sm:text-5xl">
        {t('privacy.title')}
      </h1>
      <p class="mt-4 text-lg text-[var(--text-secondary)]">
        {t('privacy.effective')}
        <br />
        {t('privacy.updated')}
      </p>
    </header>

    <div class="prose prose-lg mx-auto dark:prose-invert prose-a:text-[#ef124e] prose-a:no-underline hover:prose-a:underline">
      <p>{t('privacy.intro')}</p>

      <!-- 1 -->
      <h2>{t('privacy.s1.title')}</h2>
      <p>
        <strong>{t('privacy.s1.provided.title')}</strong>
        {t('privacy.s1.provided.text')}
      </p>
      <p>
        <strong>{t('privacy.s1.auto.title')}</strong>
        {t('privacy.s1.auto.text')}
      </p>
      <ul>
        {autoItems.map((n) => (
          <li>{k(`privacy.s1.auto${n}`)}</li>
        ))}
      </ul>
      <p>
        <strong>{t('privacy.s1.cookies.title')}</strong>
        {t('privacy.s1.cookies.text')}
      </p>

      <!-- 2 -->
      <h2>{t('privacy.s2.title')}</h2>
      <ul>
        {useItems.map((n) => (
          <li>{k(`privacy.s2.item${n}`)}</li>
        ))}
      </ul>
      <p>{t('privacy.s2.note')}</p>

      <!-- 3 -->
      <h2>{t('privacy.s3.title')}</h2>
      <p>{t('privacy.s3.text')}</p>

      <!-- 4 -->
      <h2>{t('privacy.s4.title')}</h2>
      <p>{t('privacy.s4.p1')}</p>
      <p>{t('privacy.s4.p2')}</p>
      <p>{t('privacy.s4.choicesIntro')}</p>
      <ul>
        {choiceItems.map((n) => (
          <li set:html={k(`privacy.s4.choice${n}`)} />
        ))}
      </ul>
      <p>{t('privacy.s4.note')}</p>

      <!-- 5 -->
      <h2>{t('privacy.s5.title')}</h2>
      <p>{t('privacy.s5.text')}</p>

      <!-- 6 -->
      <h2>{t('privacy.s6.title')}</h2>
      <p>{t('privacy.s6.text')}</p>

      <!-- 7 -->
      <h2>{t('privacy.s7.title')}</h2>
      <p>{t('privacy.s7.text')}</p>

      <!-- 8 -->
      <h2>{t('privacy.s8.title')}</h2>
      <p>{t('privacy.s8.text')}</p>

      <!-- 9 (contains email link) -->
      <h2>{t('privacy.s9.title')}</h2>
      <p set:html={t('privacy.s9.text')} />

      <!-- 10 -->
      <h2>{t('privacy.s10.title')}</h2>
      <p>{t('privacy.s10.text')}</p>

      <!-- 11 -->
      <h2>{t('privacy.s11.title')}</h2>
      <p>{t('privacy.s11.text')}</p>

      <!-- 12 -->
      <h2>{t('privacy.s12.title')}</h2>
      <p>{t('privacy.s12.text')}</p>

      <!-- 13 -->
      <h2>{t('privacy.s13.title')}</h2>
      <p>{t('privacy.s13.text')}</p>

      <!-- 14 -->
      <h2>{t('privacy.s14.title')}</h2>
      <p>
        <strong>{t('privacy.s14.name')}</strong>
        <br />
        {t('privacy.s14.emailLabel')}{' '}
        <a href="mailto:support@Musicaldown.se">support@Musicaldown.se</a>
        <br />
        {t('privacy.s14.websiteLabel')} <a href="https://Musicaldown.se">https://Musicaldown.se</a>
      </p>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
