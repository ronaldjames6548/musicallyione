---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import HeroSection from '../components/marketing/HeroSection.astro';
---
<BaseLayout title="TikTok to MP3 Converter | MusicallyDown" description="Use this page to check whether an accessible TikTok video has an audio download option. Audio formats and quality depend on the source; converting a file does not improve its original quality.">
  <Header slot="header" />
  <HeroSection />
  <main class="mx-auto max-w-4xl px-6 py-12">
    <article class="prose prose-zinc prose-lg mx-auto dark:prose-invert">
      <h1>TikTok to MP3 Converter</h1><p>Use this page to check whether an accessible TikTok video has an audio download option. Audio formats and quality depend on the source; converting a file does not improve its original quality.</p><h2>How to extract TikTok audio as MP3</h2>
      <ol><li>Copy the link to a public TikTok video.</li><li>Paste the URL into the downloader above.</li><li>Choose the audio or MP3 option if it is offered, then save the file.</li></ol>
      <h2>Important notes</h2><p>Only save content you own or have permission to use. Private, deleted, region-restricted, or unsupported links may not work. Never share your TikTok password with a downloader.</p>
    </article>
  </main>
  <Footer slot="footer" />
</BaseLayout>
