---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
---

<BaseLayout
  title="Liên hệ"
  description="Bạn có câu hỏi hoặc gặp sự cố kỹ thuật? Hãy liên hệ support@Musicaldown.se. Mô tả sự cố và không gửi mật khẩu hay thông tin cá nhân."
>
  <Header slot="header" />
  <main class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <article class="prose prose-zinc prose-lg mx-auto dark:prose-invert">
      <h1>Liên hệ</h1>
      <p>
        Bạn có câu hỏi hoặc gặp sự cố kỹ thuật? Hãy liên hệ support@Musicaldown.se. Mô tả sự cố và
        không gửi mật khẩu hay thông tin cá nhân.
      </p>
      <h2>Hỗ trợ khách hàng</h2>
      <p>Nếu cần hỗ trợ, hãy gửi email đến support@Musicaldown.se.</p>
      <p>
        <a href="/vi/">Quay lại trang chủ</a>
      </p>
    </article>
  </main>
  <Footer slot="footer" />
</BaseLayout>
