---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
---
<BaseLayout title="Chính sách bảo mật" description="Chúng tôi xử lý liên kết bạn gửi để tìm các tùy chọn nội dung có sẵn. Không gửi mật khẩu hoặc thông tin cá nhân.">
  <Header slot="header" />
  <main class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <article class="prose prose-zinc prose-lg mx-auto dark:prose-invert">
      <h1>Chính sách bảo mật</h1>
      <p>Chúng tôi xử lý liên kết bạn gửi để tìm các tùy chọn nội dung có sẵn. Không gửi mật khẩu hoặc thông tin cá nhân.</p>
      <h2>Quyền riêng tư và dữ liệu</h2>
      <p>Chúng tôi xử lý liên kết bạn gửi để tìm các tùy chọn nội dung có sẵn. Không gửi mật khẩu hoặc thông tin cá nhân.</p>
      <p><a href="/vi/">Quay lại trang chủ</a></p>
    </article>
  </main>
  <Footer slot="footer" />
</BaseLayout>
